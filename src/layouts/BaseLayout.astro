---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale?: "zh" | "en";
  path?: string;
  article?: boolean;
}

const { title, description, locale = "zh", path = Astro.url.pathname, article = false } = Astro.props;
const isHome = path === "/" || path === "/en";
const fullTitle = isHome ? title : `${title}｜Adam Cui`;
const canonical = new URL(path, Astro.site ?? "https://www.adamcui.cn");
const socialImage = article ? undefined : new URL("/og.png", Astro.site ?? "https://www.adamcui.cn");
---
<!doctype html>
<html lang={locale === "en" ? "en" : "zh-CN"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body>
    <Header locale={locale} path={path} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
