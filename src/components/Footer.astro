---
interface Props { locale?: "zh" | "en"; }
const { locale = "zh" } = Astro.props;
const isEnglish = locale === "en";
const prefix = isEnglish ? "/en" : "";
---
<footer class="footer shell">
  <div><strong>Adam Cui</strong><p>{isEnglish ? "Operating Improvement" : "企业经营提升"}</p></div>
  <div class="footer-links"><a href={`${prefix}/insights`}>{isEnglish ? "Insights" : "洞察"}</a><a href={`${prefix}/playbooks`}>{isEnglish ? "Method" : "方法"}</a><a href={`${prefix}/about`}>{isEnglish ? "About" : "关于"}</a></div>
  <p class="copyright">© {new Date().getFullYear()} Adam Cui</p>
</footer>
